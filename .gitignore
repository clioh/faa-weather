# Logs
logs
*.log
npm-debug.log*

# Dependency directories
node_modules/

# Compiled output
dist/
build/

# IDEs and editors
.idea/
.vscode/

# System files
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.local
.env.*.local
config/config.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Face recognition data (contains your face embeddings)
packages/presence/face_data/

# Camera test snapshots written by packages/presence/test_camera.py
packages/presence/*snapshot_*.jpg

# Turbo
.turbo/

# SQLite databases
*.db
*.sqlite

# Runtime data (SQLite DB + -wal/-shm sidecars, layouts) written by the backend
data/*
!data/.gitkeep

# License server SQLite DB + sidecars

# TypeScript incremental build info and tsc output emitted next to sources
*.tsbuildinfo
packages/frontend/vite.config.js
packages/frontend/vite.config.d.ts

# Expo / React Native
.expo/
packages/mobile/dist/
packages/mobile/web-build/

# NOTE: do not blanket-ignore *.js; babel.config.js etc. must stay tracked.

# Updater staging/backup directories and test caches
.update-temp/
.update-stage/
.update-lock/
.update-snapshot/
.update-state
.update-state.tmp
.update-hltest.*
.backup/
.pytest_cache/
