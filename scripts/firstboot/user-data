#cloud-config
#
# SkyGlass First Boot Configuration
# This file is placed in the boot partition to configure the Pi on first boot
#

# Set hostname
hostname: skyglass
manage_etc_hosts: true

# Create default user
users:
  - name: pi
    groups: [adm, dialout, cdrom, sudo, audio, video, plugdev, games, users, input, netdev, gpio, i2c, spi]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    # Password: skyglass (change on first login recommended)
    passwd: $6$rounds=656000$randomsalt$HashedPasswordHere

# Enable SSH
ssh_pwauth: true

# Set timezone (will be updated during setup wizard)
timezone: America/New_York

# Expand filesystem
growpart:
  mode: auto
  devices: ['/']

# Package updates and installation
package_update: true
package_upgrade: false

packages:
  - git
  - curl

# Run commands on first boot
runcmd:
  # Wait for network
  - |
    for i in $(seq 1 30); do
      ping -c 1 github.com && break
      sleep 2
    done

  # Enable camera interface
  - raspi-config nonint do_camera 0 || true

  # Enable I2C
  - raspi-config nonint do_i2c 0 || true

  # Clone SkyGlass repository
  - |
    cd /home/pi
    if [ ! -d "SkyGlass" ]; then
      sudo -u pi git clone https://github.com/YOUR_USERNAME/SkyGlass.git SkyGlass
    fi

  # Make setup script executable
  - chmod +x /home/pi/SkyGlass/scripts/setup-pi.sh

  # Create auto-setup service that runs after cloud-init
  - |
    cat > /etc/systemd/system/skyglass-autosetup.service << 'EOF'
    [Unit]
    Description=SkyGlass Auto Setup
    After=network-online.target cloud-final.service
    Wants=network-online.target
    ConditionPathExists=!/home/pi/SkyGlass/.setup-complete

    [Service]
    Type=oneshot
    User=pi
    WorkingDirectory=/home/pi/SkyGlass
    Environment=DEBIAN_FRONTEND=noninteractive
    ExecStart=/bin/bash -c 'yes | ./scripts/setup-pi.sh && touch .setup-complete'
    RemainAfterExit=yes
    TimeoutStartSec=1800

    [Install]
    WantedBy=multi-user.target
    EOF

  - systemctl daemon-reload
  - systemctl enable skyglass-autosetup.service

  # Reboot to start fresh with all configurations
  - reboot

# Final message
final_message: "SkyGlass first boot complete. System will reboot to finish setup."
