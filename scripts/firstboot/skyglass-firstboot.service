[Unit]
Description=SkyGlass First Boot Setup
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/home/pi/.skyglass-setup-complete

[Service]
Type=oneshot
ExecStart=/usr/local/bin/skyglass-firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
