# ===================
# Feature Flags
# ===================

# Enable e-commerce mode (shows "Add to Cart" instead of "Join Waitlist")
# Set to "true" to enable purchasing
VITE_FEATURE_ECOMMERCE=false

# Enable pre-order mode (shows pre-order messaging)
VITE_FEATURE_PREORDERS=false

# ===================
# Stripe (Payments)
# ===================

# Stripe Secret Key (server-side) - Get from https://dashboard.stripe.com/apikeys
# Use test key (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx

# Stripe Publishable Key (client-side) - Get from https://dashboard.stripe.com/apikeys
# Use test key (pk_test_...) for development
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxx

# Stripe Webhook Secret - Get from https://dashboard.stripe.com/webhooks
# Create a webhook endpoint pointing to /api/webhook
# For local testing, use Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# ===================
# Stripe Tax Setup
# ===================
# Stripe Tax calculates sales tax, VAT, and GST automatically based on customer location.
#
# To enable Stripe Tax:
# 1. Go to https://dashboard.stripe.com/tax/registrations
# 2. Add your business address (origin address for tax calculations)
# 3. Register for tax collection in states/countries where you have nexus
# 4. Stripe Tax is billed at 0.5% per transaction (on top of payment fees)
#
# If Stripe Tax is not configured, the checkout will fall back to a flat 8.75% tax rate.
#
# Tax codes used:
# - txcd_99999999: General tangible goods (hardware kits)
# - txcd_92010001: Shipping for tangible goods
#
# For more info: https://stripe.com/docs/tax

# ===================
# Promo Codes Setup
# ===================
# Promo codes are managed via Stripe Coupons and Promotion Codes.
#
# To create a promo code:
# 1. Go to https://dashboard.stripe.com/coupons
# 2. Create a new Coupon (e.g., 15% off, $50 off)
# 3. Add a Promotion Code to the coupon (e.g., "EARLYBIRD", "WELCOME10")
# 4. Set optional restrictions:
#    - Usage limits (total or per-customer)
#    - Expiration date
#    - Minimum order amount
#    - First-time customers only
#
# Example codes to create for launch:
# - EARLYBIRD: 15% off (first 100 customers)
# - WELCOME10: $10 off first order
# - PILOT20: 20% off (for aviation community partnerships)
#
# For more info: https://stripe.com/docs/billing/subscriptions/coupons

# ===================
# Admin Dashboard
# ===================

# Simple password protection for admin routes
# In production, use a proper auth system
ADMIN_PASSWORD=your-secure-admin-password

# ===================
# Resend (Email)
# ===================

# Resend API Key - Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# Resend Audience ID - Create an audience at https://resend.com/audiences
# Then copy the audience ID
RESEND_AUDIENCE_ID=aud_xxxxxxxxxx

# ===================
# Licensing (api/license/*, api/admin/licenses; see docs/LICENSING.md)
# ===================
# If DATABASE_URL or LICENSE_SIGNING_KEY is unset, the license API answers
# 503 {status:"not_configured"} and the webhook returns 500 for licensed
# orders so Stripe retries until it is configured.

# Neon Postgres connection string (Vercel Marketplace > Neon sets this).
# Create the tables with: npm run db:migrate --workspace=packages/website
DATABASE_URL=

# Ed25519 private key (PKCS8 PEM, base64-encoded onto one line) that signs
# activation tokens. Generate with: node scripts/license-keygen.mjs
# Paste the matching public key into packages/backend/src/license/public-key.ts.
LICENSE_SIGNING_KEY=

# HMAC secret for the 30-minute sign-in links at skyglass.dev/license.
# Generate one with: openssl rand -hex 32
LICENSE_MANAGE_SECRET=

# ===================
# SkyGlass sign-in service (cloud OAuth broker, api/oauth/*)
# ===================
# Mirrors fetch public client IDs from GET /api/oauth/config and exchange/refresh
# Google tokens through POST /api/oauth/google/token. The Google client secret
# lives only here (never on mirrors). A provider is reported as unavailable
# (null) when its variables are unset.

# Google OAuth client (Web application) from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, default https://skyglass.dev/oauth/google (the static bounce page)
GOOGLE_REDIRECT_URI=

# Microsoft (Entra ID) public client app ID; device code flow runs on the mirror,
# so there is no secret. Tenant is optional, default "common".
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=

# ===================
# SkyGlass data service (keyed upstream proxy, api/data/*)
# ===================
# Mirrors hold no third-party API keys. They call these CDN-cached endpoints
# instead (docs/CLOUD_SERVICE.md). Each endpoint answers
# 503 {"error":"not_configured"} while its variables are unset; mirrors then
# fall back (stocks -> keyless Yahoo) or show no NOTAMs.

# FAA NOTAM API (https://api.faa.gov, "NOTAM API" app). Both are sent as the
# client_id / client_secret request headers, server-side only.
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=
# Optional endpoint override (https only), default
# https://external-api.faa.gov/notamapi/v1/notams
FAA_NOTAM_API_URL=

# Finnhub API key (https://finnhub.io/dashboard) for /api/data/stocks and
# /api/data/stock-profiles. Sent as the X-Finnhub-Token header.
FINNHUB_API_KEY=
