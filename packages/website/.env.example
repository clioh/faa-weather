# ===================
# Feature Flags
# ===================

# Enable e-commerce mode (shows "Add to Cart" instead of "Join Waitlist")
# Set to "true" to enable purchasing
VITE_FEATURE_ECOMMERCE=false

# Enable pre-order mode (shows pre-order messaging)
VITE_FEATURE_PREORDERS=false

# ===================
# Stripe (Payments)
# ===================

# Stripe Secret Key (server-side) - Get from https://dashboard.stripe.com/apikeys
# Use test key (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx

# Stripe Publishable Key (client-side) - Get from https://dashboard.stripe.com/apikeys
# Use test key (pk_test_...) for development
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxx

# Stripe Webhook Secret - Get from https://dashboard.stripe.com/webhooks
# Create a webhook endpoint pointing to /api/webhook
# For local testing, use Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# ===================
# Stripe Tax Setup
# ===================
# Stripe Tax calculates sales tax, VAT, and GST automatically based on customer location.
#
# To enable Stripe Tax:
# 1. Go to https://dashboard.stripe.com/tax/registrations
# 2. Add your business address (origin address for tax calculations)
# 3. Register for tax collection in states/countries where you have nexus
# 4. Stripe Tax is billed at 0.5% per transaction (on top of payment fees)
#
# If Stripe Tax is not configured, the checkout will fall back to a flat 8.75% tax rate.
#
# Tax codes used:
# - txcd_99999999: General tangible goods (hardware kits)
# - txcd_92010001: Shipping for tangible goods
#
# For more info: https://stripe.com/docs/tax

# ===================
# Promo Codes Setup
# ===================
# Promo codes are managed via Stripe Coupons and Promotion Codes.
#
# To create a promo code:
# 1. Go to https://dashboard.stripe.com/coupons
# 2. Create a new Coupon (e.g., 15% off, $50 off)
# 3. Add a Promotion Code to the coupon (e.g., "EARLYBIRD", "WELCOME10")
# 4. Set optional restrictions:
#    - Usage limits (total or per-customer)
#    - Expiration date
#    - Minimum order amount
#    - First-time customers only
#
# Example codes to create for launch:
# - EARLYBIRD: 15% off (first 100 customers)
# - WELCOME10: $10 off first order
# - PILOT20: 20% off (for aviation community partnerships)
#
# For more info: https://stripe.com/docs/billing/subscriptions/coupons

# ===================
# Admin Dashboard
# ===================

# Simple password protection for admin routes
# In production, use a proper auth system
ADMIN_PASSWORD=your-secure-admin-password

# ===================
# Resend (Email)
# ===================

# Resend API Key - Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# Resend Audience ID - Create an audience at https://resend.com/audiences
# Then copy the audience ID
RESEND_AUDIENCE_ID=aud_xxxxxxxxxx

# ===================
# License Server
# ===================

# Base URL of the SkyGlass license server (default: https://license.skyglass.dev)
LICENSE_SERVER_URL=https://license.skyglass.dev

# REQUIRED for license creation. Shared secret sent by api/webhook.ts as
# "Authorization: Bearer <LICENSE_API_KEY>" when creating a license after a
# successful checkout. Must match LICENSE_API_KEY on the license server
# (packages/license-server/.env.example). If unset here, the webhook skips
# license creation; if unset on the license server, it rejects with 503.
# Generate one with: openssl rand -hex 32
LICENSE_API_KEY=
