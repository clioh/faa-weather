# Server
PORT=3001
NODE_ENV=development

# Cloud Relay (optional)
CLOUD_RELAY_URL=wss://api.skyglass.dev/ws/relay

# No third-party API keys belong here. NOTAMs, stock quotes and calendar
# sign-in go through the SkyGlass cloud service (config `skyglass_service`,
# default https://skyglass.dev), which holds those keys. See docs/CLOUD_SERVICE.md.
