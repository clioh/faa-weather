{
  "expo": {
    "name": "SkyGlass",
    "slug": "skyglass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "skyglass",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skyglass.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SkyGlass uses your camera to register your face for presence detection.",
        "NSLocationWhenInUseUsageDescription": "SkyGlass uses your location to provide accurate sunrise/sunset times and local weather.",
        "NSLocalNetworkUsageDescription": "SkyGlass needs to discover your mirror on the local network.",
        "NSBonjourServices": ["_skyglass._tcp", "_http._tcp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.skyglass.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SkyGlass uses your camera for face registration and QR code scanning."
        }
      ],
      "expo-location"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
