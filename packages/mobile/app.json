{
  "expo": {
    "name": "SkyGlass",
    "slug": "skyglass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "skyglass",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skyglass.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SkyGlass uses your location to provide accurate sunrise/sunset times and local weather.",
        "NSLocalNetworkUsageDescription": "SkyGlass needs to discover your mirror on the local network.",
        "NSBonjourServices": ["_skyglass._tcp"],
        "NSCameraUsageDescription": "SkyGlass uses the camera to scan the QR code on your mirror."
      },
      "associatedDomains": ["applinks:skyglass.dev", "applinks:www.skyglass.dev"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.skyglass.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "ACCESS_NETWORK_STATE"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "skyglass.dev",
              "pathPrefix": "/connect"
            },
            {
              "scheme": "https",
              "host": "skyglass.dev",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.skyglass.dev",
              "pathPrefix": "/connect"
            },
            {
              "scheme": "https",
              "host": "www.skyglass.dev",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SkyGlass uses your location to provide accurate sunrise/sunset times and local weather.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SkyGlass uses your photos so you can choose pictures for the mirror's photo frame.",
          "cameraPermission": "SkyGlass uses the camera to scan the QR code on your mirror.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SkyGlass uses the camera to scan the QR code on your mirror.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
