{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "SKYGLASS_*",
        "VITE_*",
        "EXPO_*",
        "NODE_ENV",
        "PORT",
        "TMPDIR",
        "CORS_*",
        "CLOUD_RELAY_URL",
        "GITHUB_REPO",
        "CAMERA_INDEX",
        "DEBUG",
        "DATABASE_URL",
        "STRIPE_*",
        "CLERK_*",
        "RESEND_*",
        "ADMIN_PASSWORD",
        "LICENSE_*"
      ]
    },
    "test": {
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": ["eslint.config.mjs"]
}
