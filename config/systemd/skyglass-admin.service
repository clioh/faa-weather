[Unit]
Description=SkyGlass Admin Portal
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/SkyGlass/packages/presence

# Use the virtual environment
Environment="PATH=/home/pi/SkyGlass/packages/presence/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PORT=5000"
Environment="LOG_LEVEL=info"

# Run with Gunicorn
ExecStart=/home/pi/SkyGlass/packages/presence/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app

# Restart on failure
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sg-admin

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/SkyGlass/packages/presence/face_data
ReadWritePaths=/home/pi/SkyGlass/config
PrivateTmp=true

# Allow camera access (for enrollment)
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
