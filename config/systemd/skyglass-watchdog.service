[Unit]
Description=SkyGlass Hardware Watchdog
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/pi/SkyGlass/packages/presence

# Use the virtual environment
Environment="PATH=/home/pi/SkyGlass/packages/presence/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Run watchdog service (needs root for /dev/watchdog). It restarts the
# SkyGlass PM2 apps as the install user (--pm2-user; setup-pi.sh replaces
# "pi" and /home/pi with the installing user). The UI is served by the
# backend on 3001.
ExecStart=/home/pi/SkyGlass/packages/presence/venv/bin/python watchdog_service.py --interval 15 --pm2-user pi

# Restart on failure
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skyglass-watchdog

[Install]
WantedBy=multi-user.target
