[Unit]
Description=SkyGlass mDNS/Bonjour Service
After=network-online.target avahi-daemon.service
Wants=network-online.target avahi-daemon.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/SkyGlass/packages/presence

# Use the virtual environment
Environment="PATH=/home/pi/SkyGlass/packages/presence/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Run mDNS service
ExecStart=/home/pi/SkyGlass/packages/presence/venv/bin/python mdns_service.py --http-port 80 --admin-port 5000

# Restart on failure
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sg-mdns

[Install]
WantedBy=multi-user.target
